# Copy this file to .env and adjust for your local machine.
# Never commit a real .env file.

APP_NAME="HSDG & Associates MIS"
ENVIRONMENT=development
DEBUG=true

# SQLAlchemy connection string for PostgreSQL.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hsdg_mis

# Comma-separated list of origins allowed to call the API (the Vite dev
# server by default).
CORS_ORIGINS=http://localhost:5173
